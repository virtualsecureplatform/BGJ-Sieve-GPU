Bootstrap: docker
From: nvidia/cuda:13.3.0-devel-ubuntu24.04

%labels
    CUDA 13.3.0
    GPU A100 (sm_80)
    Purpose BGJ-Sieve-GPU development and build environment

%environment
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        git \
        libgmp-dev \
        libmpfr-dev \
        libnuma-dev \
        libntl-dev \
        libtool \
        libtool-bin \
        pkg-config \
        python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

%test
    nvcc --version
    g++ --version
    command -v autoreconf
    command -v libtoolize
    command -v pkg-config
    test -f /usr/include/gmp.h
    test -f /usr/include/mpfr.h
    test -f /usr/include/NTL/LLL.h
    test -f /usr/include/numa.h
    python3 --version
