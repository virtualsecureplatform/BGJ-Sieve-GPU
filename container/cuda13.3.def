Bootstrap: docker
From: nvidia/cuda:13.3.0-devel-ubuntu24.04

%labels
    CUDA 13.3.0
    GPU A100 (sm_80)
    Purpose BGJ-Sieve-GPU build environment

%environment
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cython3 \
        git \
        libeigen3-dev \
        libgmp-dev \
        libnuma-dev \
        libntl-dev \
        pkg-config \
        python3 \
        python3-cysignals-bare \
        python3-dev \
        python3-matplotlib \
        python3-numpy \
        python3-setuptools
    rm -rf /var/lib/apt/lists/*

%test
    nvcc --version
    g++ --version
    python3 -c 'import Cython, cysignals, matplotlib, numpy'
    dpkg-query -W libeigen3-dev libntl-dev libgmp-dev libnuma-dev
