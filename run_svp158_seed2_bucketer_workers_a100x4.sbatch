#!/bin/bash
#SBATCH --job-name=svp158-s2-buc
#SBATCH --partition=gr20100g
#SBATCH --rsc=g=4
#SBATCH --array=20,24%2
#SBATCH --time=06:00:00

set -euo pipefail

SOURCE="${SLURM_SUBMIT_DIR}"
BUCKET_THREADS="${SLURM_ARRAY_TASK_ID}"
export SVP_DIMENSION=158
export SVP142_LATTICE_SEED=2
export SVP_INSTANCE=svp158-seed2
export SVP142_INPUT_DIR="/LARGE0/gr20116/${USER}/BGJ-Sieve-GPU/inputs/${SVP_INSTANCE}"
export SVP142_RUN_DIR="/LARGE0/gr20116/${USER}/BGJ-Sieve-GPU/runs/${SVP_INSTANCE}/variants/noprofile-buc${BUCKET_THREADS}/job-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
export SVP142_REPRO="${SOURCE}/reproduce/svp158-search/reproduce.py"
export SVP_PREPROCESS_MODE=potlll-bkz
export SVP_BKZ_BETA=70
export SVP_BKZ_LOOPS=8
export BGJ_ENABLE_PROFILING=0
export TARGET_SIEVING_DIM=139
export MIN_LIFTING_DIM=120
export SVP_TIMEOUT_SECONDS=21300
export APPTAINERENV_HD_BUCKET_THREADS="${BUCKET_THREADS}"
export APPTAINERENV_HD_GPU_NATIVE_BWC=0
export APPTAINERENV_HD_GPU_NATIVE_BWC_P2P=0
export APPTAINERENV_HD_GPU_NATIVE_BWC_VERIFY=0

exec bash "${SOURCE}/run_svp142_seed0_a100x4.sbatch"
